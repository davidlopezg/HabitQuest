# ==== COACH CON IA — PROVEEDOR: MiniMax ====
# 1) Crea tu clave en https://platform.minimax.io (API Keys).
# 2) Cópiala AQUÍ para desarrollo local (NUNCA la subas al repo):
VITE_MINIMAX_API_KEY="tu-api-key-de-minimax"

# Opcional: modelo y endpoint (por defecto MiniMax-M2 / plataforma internacional).
VITE_MINIMAX_MODEL="MiniMax-M2"
# VITE_MINIMAX_BASE_URL="https://api.minimax.io/v1"

# Para PRODUCCIÓN (GitHub Pages) la key NO va en este archivo:
# repo → Settings → Secrets and variables → Actions → New repository secret
# nombre: VITE_MINIMAX_API_KEY  (el workflow la inyecta en el build automáticamente)
#
# ⚠️ Una SPA estática incrusta la key en el JS del navegador. Para uso personal
# es aceptable; para una app pública usa un proxy serverless o restringe la key.

# (Legado, ya no se usa: Gemini)
# GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration (optional - for cloud sync)
# Create a project at https://console.firebase.google.com
# Enable Authentication > Google
# Enable Firestore Database
# Copy your config values below:
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"
