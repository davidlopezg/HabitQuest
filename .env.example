# ==== COACH CON IA — PROVEEDOR: MiniMax ====
#
# HAY DOS MODOS (GitHub Pages es estático: todo lo VITE_* acaba en el JS público):
#
# MODO A · USO PERSONAL — directo a MiniMax (la key se incrusta en el bundle):
#   1) Crea tu clave en https://platform.minimax.io (API Keys).
#   2) Cópiala AQUÍ para desarrollo local (NUNCA la subas al repo):
VITE_MINIMAX_API_KEY="tu-api-key-de-minimax"
#   Para GitHub Pages: NO en este archivo. Repo → Settings → Secrets and
#   variables → Actions → New repository secret: VITE_MINIMAX_API_KEY
#
# MODO B · APP PÚBLICA — vía proxy serverless (recomendado):
#   La key real vive solo en el proxy (ver ai-proxy/worker.js). En este archivo
#   (y como secret de CI) solo pones la URL pública del Worker:
# VITE_AI_PROXY_URL="https://tu-worker.tu-subdominio.workers.dev"
# VITE_AI_PROXY_TOKEN="token-compartido-opcional"
#
# PUSH REALES (avisos con la app cerrada, OPCIONAL):
#   Necesitas Firebase Cloud Messaging habilitado en tu proyecto.
#   - VITE_FIREBASE_VAPID_KEY: la clave pública VAPID (Firebase → Mensajería en
#     la nube → Par de claves web push → Clave pública).
VITE_FIREBASE_VAPID_KEY="tu-vapid-publica"
#   - Y desplegar ai-proxy/push-worker.js (ver instrucciones en el propio archivo).
#
# Opcional: modelo y endpoint (por defecto MiniMax-M2 / plataforma internacional).
VITE_MINIMAX_MODEL="MiniMax-M2"
# VITE_MINIMAX_BASE_URL="https://api.minimax.io/v1"

# (Legado, ya no se usa: Gemini)
# GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration (optional - for cloud sync)
# Create a project at https://console.firebase.google.com
# Enable Authentication > Google
# Enable Firestore Database
# Copy your config values below:
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"
